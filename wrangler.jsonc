{
  // Sitio estático + un solo endpoint bajo demanda (/api/chat). El adaptador de Astro
  // genera el Worker; los secretos (GEMINI_API_KEY) se cargan con `wrangler secret put`.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "javiermontano",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Sirve /en/ y /en igual, y deja las URL sin barra final.
    "html_handling": "auto-trailing-slash",
    // Las rutas que no existen reciben la página 404 del sitio, no un error en blanco.
    "not_found_handling": "404-page"
  },
  "vars": {
    // Se cambia aquí si Google renombra el modelo, sin tocar el código.
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_EMBED_MODEL": "gemini-embedding-001"
  },
  // Límite por visitante. El código también funciona sin este binding (en desarrollo local).
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
