---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { profile } from '../data/profile';
import { LANGS, langFromUrl, localizedPath, t, ui } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
}

const lang = langFromUrl(Astro.url);
const {
  title = `${profile.name} — ${t(profile.role, lang)}`,
  description = t(profile.tagline, lang),
} = Astro.props;

const site = Astro.site ?? new URL('https://javiermontano.dev');
const canonical = new URL(localizedPath(lang), site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* hreflang: le dice a Google que / y /en/ son la misma página en dos idiomas. */}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(localizedPath(l), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('es'), site)} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a1628" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Navegación sin recarga: cambiar de idioma reemplaza la página en sitio, sin
        pantallazo en blanco. Los scripts de los componentes se reinician con
        `astro:page-load` (ver src/scripts/page.ts). */}
    <ClientRouter />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.name,
        jobTitle: t(profile.role, lang),
        email: `mailto:${profile.email}`,
        address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
        sameAs: ['https://github.com/Jvrmmora', 'https://linkedin.com/in/jvrmmora'],
        knowsAbout: ['Node.js', 'TypeScript', 'AWS', 'Azure', 'Docker', 'MongoDB', 'PostgreSQL'],
      })}
    />

    <!-- El tema se decide antes de pintar (elección guardada, o la del sistema), así
         no hay un destello del modo equivocado. Sin JS el sitio queda en oscuro.
         localStorage puede lanzar (modo privado, datos bloqueados): todo va en try/catch. -->
    <script is:inline>
      (function () {
        var theme = 'dark';
        var saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch (e) {}
        // La preferencia del sistema no depende del almacenamiento: si este falla, se respeta igual.
        if (saved === 'light' || saved === 'dark') theme = saved;
        else if (window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'light' ? '#f4f6fa' : '#0a1628');
      })();
    </script>

    <!-- Marca el documento antes de pintar, para que el CSS oculte lo animable
         solo cuando JS está vivo y va a revelarlo.
         El temporizador es el seguro: si GSAP no carga (red lenta, error, bloqueador),
         a los 2s se retira la clase y TODO el contenido aparece. Sin esto, un fallo
         del script dejaría la página en blanco bajo el hero. -->
    <script is:inline>
      // Quien pide menos movimiento en su sistema nunca llega a ver el contenido
      // oculto: la clase ni siquiera se añade, así que no depende de que cargue el JS.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
        setTimeout(function () {
          if (!document.documentElement.dataset.motionReady) {
            document.documentElement.classList.remove('js-motion');
          }
        }, 2000);
      }
    </script>
  </head>
  <body>
    <div class="read-progress" data-read-progress aria-hidden="true"></div>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:font-medium focus:text-on-accent"
    >
      {t(ui.a11y.skip, lang)}
    </a>
    <slot />

    <script>
      // Cambio de idioma sin perder el sitio. Las dos versiones tienen las mismas
      // secciones con los mismos id, pero no la misma altura (el texto mide distinto),
      // así que no sirve copiar el scroll en píxeles: se guarda QUÉ sección está arriba y
      // qué fracción de ella ya se recorrió, y se vuelve a ese mismo punto en el otro idioma.
      type Spot = { id: string; ratio: number };
      let spot: Spot | null = null;

      const anchors = () => [...document.querySelectorAll<HTMLElement>('header#top, section[id]')];

      document.addEventListener('astro:before-preparation', (event) => {
        spot = null;
        if (event.from.pathname === event.to.pathname) return;
        // La sección activa es la última cuyo borde superior ya pasó bajo la barra.
        const line = 80;
        const current = anchors().filter((el) => el.getBoundingClientRect().top <= line).pop();
        if (!current) return;
        const rect = current.getBoundingClientRect();
        spot = { id: current.id, ratio: (line - rect.top) / rect.height };
      });

      document.addEventListener('astro:before-swap', (event) => {
        const next = event.newDocument.documentElement;
        const now = document.documentElement;
        // El tema lo decide un script del <head> que no se vuelve a ejecutar: se hereda.
        if (now.dataset.theme) next.dataset.theme = now.dataset.theme;
        // Sin `js-motion` el contenido llega ya visible: al cambiar de idioma no se
        // repiten las entradas animadas, la página simplemente aparece traducida.
        next.dataset.motionReady = 'true';
      });

      document.addEventListener('astro:after-swap', () => {
        const target = spot;
        spot = null;
        const el = target && document.getElementById(target.id);
        if (!target || !el) return;
        const align = () => jumpTo(window.scrollY + el.getBoundingClientRect().top + target.ratio * el.offsetHeight - 80);
        align();

        // Las imágenes de más arriba aún pueden estar cargando y, al ganar altura, empujan
        // la sección hacia abajo. Durante un momento se re-alinea con cada cambio de
        // tamaño, hasta que la persona toque el scroll: desde ahí manda ella.
        const settle = new ResizeObserver(align);
        settle.observe(document.body);
        const release = () => {
          settle.disconnect();
          for (const type of ['wheel', 'touchstart', 'keydown'] as const) removeEventListener(type, release);
        };
        for (const type of ['wheel', 'touchstart', 'keydown'] as const) addEventListener(type, release, { passive: true });
        setTimeout(release, 2500);
      });

      // Lenis lleva su propia cuenta del scroll: si existe, el salto pasa por él.
      function jumpTo(y: number) {
        const lenis = (window as { siteLenis?: { scrollTo: (y: number, o: object) => void } }).siteLenis;
        if (lenis) lenis.scrollTo(y, { immediate: true, force: true });
        else window.scrollTo({ top: y, behavior: 'instant' });
      }
    </script>
  </body>
</html>
