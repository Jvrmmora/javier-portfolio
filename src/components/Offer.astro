---
// Puerta de entrada: qué pasa si el visitante da el primer paso. Va al final de
// Servicios, justo donde se pregunta "¿y cómo empiezo?". Misma fila editorial que los
// servicios (borde arriba y abajo, sin tarjeta) para que se lea como parte del contenido.
import { CAL_URL, getChannels } from '../data/profile';
import { langFromUrl, t, ui } from '../i18n/config';

const lang = langFromUrl(Astro.url);
const whatsapp = getChannels(lang).find((c) => c.icon === 'whatsapp')!;
---

<section id="empezar" class="container-site pt-12 md:pt-16" aria-labelledby="offer-title">
  <div class="grid gap-x-10 gap-y-8 rounded-3xl border border-line bg-surface/60 p-6 md:p-10 lg:grid-cols-12" data-reveal>
    <div class="lg:col-span-7">
      <p class="meta mb-4">{t(ui.sections.offerEyebrow, lang)}</p>
      <h3 id="offer-title" class="font-display text-3xl leading-tight font-semibold tracking-[-0.03em] md:text-4xl">
        {t(ui.sections.offerTitle, lang)}
      </h3>
      <p class="mt-4 max-w-[58ch] leading-relaxed text-muted">{t(ui.sections.offerBody, lang)}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
        <a
          href={CAL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full rounded-lg bg-accent px-6 py-3.5 text-center text-sm font-semibold text-on-accent transition-opacity hover:opacity-90 sm:w-auto"
        >
          {t(ui.hero.book, lang)}
        </a>
        <a
          href={whatsapp.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent-text hover:decoration-accent-text"
        >
          {t(ui.hero.whatsapp, lang)}
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <p class="meta mb-4">{t(ui.sections.includes, lang)}</p>
      <ul class="grid gap-3">
        {ui.sections.offerDeliverables[lang].map((item) => (
          <li class="flex items-start gap-2.5 text-[15px] leading-snug">
            <svg class="mt-0.5 shrink-0 text-accent-text" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m5 13 4 4 10-11" />
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
