---
import { profile } from '../data/profile';
import { langFromUrl, localizedPath, t, ui } from '../i18n/config';

const lang = langFromUrl(Astro.url);
const other = lang === 'es' ? 'en' : 'es';

// Los id de las secciones son los mismos en ambos idiomas: un enlace compartido
// a /#proyectos o /en/#proyectos funciona igual.
const links = [
  { href: '#servicios', label: t(ui.nav.services, lang) },
  { href: '#proyectos', label: t(ui.nav.projects, lang) },
  { href: '#experiencia', label: t(ui.nav.experience, lang) },
  { href: '#stack', label: t(ui.nav.stack, lang) },
];
---

<!-- Barra flotante en forma de píldora. El blur es funcional: mantiene legible la barra
     sobre el contenido que pasa por debajo. -->
<nav class="sticky top-0 z-40 px-3 pt-3 md:px-6" aria-label={t(ui.a11y.mainNav, lang)}>
  <div
    class="container-site flex h-14 items-center justify-between gap-4 rounded-full border border-line bg-bg/75 py-2 pr-2 pl-2 shadow-[0_8px_30px_-12px_rgb(0_0_0/0.25)] backdrop-blur-xl"
  >
    <a
      href={`${localizedPath(lang)}#top`}
      aria-label={t(ui.a11y.home, lang)}
      class="flex items-center gap-2.5 rounded-full py-1 pr-3 pl-1 transition-colors hover:bg-surface"
    >
      {/* Mismo monograma que el favicon: ámbar sobre navy en los dos modos. */}
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#0a1628] text-[13px] font-extrabold tracking-[-0.02em] text-accent"
        aria-hidden="true"
      >
        JM
      </span>
      {/* El cargo solo desde 1024px: con los enlaces visibles, por debajo no cabe. */}
      <span class="hidden text-[15px] font-semibold tracking-[-0.01em] whitespace-nowrap lg:inline">
        {t(profile.role, lang)}
      </span>
    </a>

    <!-- Cápsula de secciones: la activa se resalta al hacer scroll (script abajo). -->
    <ul class="hidden items-center gap-1 rounded-full bg-surface/70 p-1 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-nav-link={l.href.slice(1)}
              class="block rounded-full px-4 py-1.5 text-sm text-muted transition-colors hover:text-text aria-[current=true]:bg-bg aria-[current=true]:text-text aria-[current=true]:shadow-sm"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1.5">
      <div class="flex items-center rounded-full bg-surface/70 p-1">
        <a
          href={localizedPath(other)}
          hreflang={other}
          lang={other}
          aria-label={t(ui.a11y.langSwitch, lang)}
          title={t(ui.a11y.langSwitch, lang)}
          class="flex h-8 min-w-8 items-center justify-center rounded-full px-2 text-xs font-semibold text-muted uppercase transition-colors hover:bg-bg hover:text-text"
        >
          {other}
        </a>
        <!-- Muestra el icono de lo que HARÁ al pulsarlo: en oscuro un sol, en claro una luna.
             El nombre accesible se actualiza por JS con la misma lógica. -->
        <button
          type="button"
          data-theme-toggle
          aria-label={t(ui.a11y.toLight, lang)}
          data-label-light={t(ui.a11y.toLight, lang)}
          data-label-dark={t(ui.a11y.toDark, lang)}
          title={t(ui.a11y.themeToggle, lang)}
          class="flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-bg hover:text-text"
        >
          <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>
      <!-- Contacto es la acción principal de la barra: ámbar, como todo lo que es acción. -->
      <a
        href="#contacto"
        data-nav-link="contacto"
        class="flex h-10 items-center rounded-full bg-accent px-4 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
      >
        {t(ui.nav.contact, lang)}
      </a>
    </div>
  </div>
</nav>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeColor = document.querySelector('meta[name="theme-color"]');

  const sync = () => {
    const light = root.dataset.theme === 'light';
    toggle?.setAttribute('aria-label', (light ? toggle.dataset.labelDark : toggle.dataset.labelLight) ?? '');
    themeColor?.setAttribute('content', light ? '#f4f6fa' : '#0a1628');
  };
  sync();

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    sync();
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Sin almacenamiento la elección dura solo esta visita: aceptable.
    }
  });

  // Resalta en la barra la sección que está en pantalla. La franja de detección es una
  // línea cerca del centro vertical, así solo una sección está activa a la vez.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const ids = [...new Set([...navLinks].map((a) => a.dataset.navLink!))];
  const setActive = (id: string | null) =>
    navLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.navLink === id)));

  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
    },
    { rootMargin: '-45% 0px -54% 0px' },
  );
  ids.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
  // En el hero no hay sección activa.
  new IntersectionObserver(([e]) => e.isIntersecting && setActive(null), { rootMargin: '-45% 0px -54% 0px' })
    .observe(document.getElementById('top')!);
</script>
