---
import Icon from './Icon.astro';
import { metrics } from '../data/profile';
import { langFromUrl, t } from '../i18n/config';

const lang = langFromUrl(Astro.url);
// 200.000 en español, 200,000 en inglés. El script de conteo usa el mismo locale.
const locale = lang === 'es' ? 'es-CO' : 'en-US';
const fmt = (n: number) => n.toLocaleString(locale);
---

<section
  class="container-site"
  aria-label={lang === 'es' ? 'Resultados' : 'Results'}
>
  <!-- data-reveal-group: las tarjetas entran una tras otra, no todas a la vez. -->
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 md:gap-4" data-reveal-group>
    {
      metrics.map((m) => (
        <div
          class="@container group relative isolate flex flex-col overflow-hidden rounded-2xl border border-line bg-surface/50 p-6 transition-[translate,border-color,background-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-accent-text/40 hover:bg-surface hover:shadow-[0_18px_40px_-20px_rgb(0_0_0/0.35)] md:p-7"
          data-reveal
          data-spotlight
        >
          {/* Arriba, el rótulo a la izquierda y con qué se logró a la derecha: los logos
              en losetas del mismo tamaño, para que una tarjeta con uno y otra con dos
              se vean igual de completas. Al pasar el ratón se encienden en ámbar. */}
          <div class="flex items-start justify-between gap-4">
            <p class="meta pt-2.5">{t(m.title, lang)}</p>
            <ul class="flex shrink-0 gap-1.5">
              {m.logos.map((name, i) => (
                <li
                  title={name}
                  class="flex h-10 w-10 items-center justify-center rounded-xl border border-line bg-bg text-text transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent"
                  style={`transition-delay: ${i * 60}ms`}
                >
                  <Icon name={name} size={20} />
                </li>
              ))}
              {'icon' in m && (
                <li class="flex h-10 w-10 items-center justify-center rounded-xl border border-line bg-bg text-text transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                    <path d={m.icon} />
                  </svg>
                </li>
              )}
            </ul>
          </div>

          {/* El tamaño sale del ancho de la propia tarjeta (cqi), no de la pantalla: así
              "200.000+" llena su tarjeta sin desbordarla en ningún ancho. */}
          <p class="font-display tabular mt-7 md:mt-10 text-[clamp(2.25rem,19cqi,3.75rem)] leading-none font-semibold tracking-[-0.04em] whitespace-nowrap">
            {'prefix' in m && m.prefix}
            <span data-count={m.count} data-count-locale={locale}>{fmt(m.count)}</span>
            {m.suffix}
            {t(m.unit, lang) && (
              <span class="ml-1 text-[0.4em] font-medium tracking-[-0.01em] text-muted">{t(m.unit, lang)}</span>
            )}
          </p>

          {/* Subrayado ámbar que crece al entrar: marca el dato sin añadir otro color. */}
          <span class="mt-5 block h-0.5 w-10 origin-left rounded-full bg-accent" data-bar />

          <p class="mt-4 text-[15px] leading-relaxed text-muted">{t(m.label, lang)}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  import '../scripts/spotlight';
</script>
