---
import { Image } from 'astro:assets';
import { profile, heroCard, getChannels, cvHref } from '../data/profile';
import { langFromUrl, t, ui } from '../i18n/config';
import portrait from '../assets/javier.jpg';
import RevealText from './RevealText.astro';

const lang = langFromUrl(Astro.url);
const whatsapp = getChannels(lang).find((c) => 'primary' in c && c.primary)!;
---

<header id="top" class="container-site pt-14 pb-16 md:pt-20 md:pb-24">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-7">
      <p class="meta mb-6 flex items-center gap-2.5" data-hero-step>
        {/* Late como un indicador de servicio activo. `motion-safe` lo apaga para
            quien pide menos movimiento en su sistema. */}
        <span class="relative flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-ok opacity-75 motion-safe:animate-ping"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-ok"></span>
        </span>
        {t(profile.availability, lang)}
      </p>

      <h1 class="font-display text-[clamp(2.5rem,8vw,5.25rem)] leading-[1.02] font-bold tracking-[-0.04em]">
        <RevealText text="Javier" as="span" class="block" immediate />
        <RevealText text="Montaño" as="span" class="block" immediate />
      </h1>

      {/* El cargo es lo segundo que se lee tras el nombre: va grande y en negrita,
          con una barra verde que lo ancla al titular. */}
      <p class="mt-5 flex items-center gap-3 text-xl font-bold tracking-[-0.02em] text-ok md:text-2xl" data-hero-step>
        <span class="h-6 w-1 shrink-0 rounded-full bg-ok md:h-7" aria-hidden="true"></span>
        {t(profile.role, lang)}
      </p>

      <p class="mt-7 max-w-[50ch] text-lg leading-relaxed text-muted" data-hero-step>
        {t(profile.tagline, lang)}
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3" data-hero-step>
        <a
          href={whatsapp.href}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-on-accent transition-opacity hover:opacity-90"
        >
          {t(ui.hero.whatsapp, lang)}
        </a>
        <!-- `download` con nombre propio: el archivo llega como "CV Javier Montaño (EN).pdf",
             no como una ruta suelta, y en el idioma que el visitante está leyendo. -->
        <a
          href={cvHref(lang)}
          download={`CV Javier Montaño (${lang.toUpperCase()}).pdf`}
          class="inline-flex items-center gap-2 rounded-lg border border-line px-6 py-3.5 text-sm transition-colors hover:border-accent-text hover:text-accent-text"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
          </svg>
          {t(ui.hero.downloadCv, lang)}
          <span class="text-muted">· {lang.toUpperCase()}</span>
        </a>
      </div>
    </div>

    <!-- Retrato vertical 4:5; la tarjeta cuelga bajo el borde inferior para no tapar la cara
         (y de paso cubre el logo del buso). Tarjeta superpuesta: modalidad, ubicación/horario e idiomas,
         lo único que un reclutador o cliente pregunta y no está ya en la página. -->
    <aside class="relative min-w-0 lg:col-span-5 lg:pl-6" data-hero-step aria-label={t(ui.hero.profile, lang)}>
      {/* El contenedor recorta; la imagen de dentro es la que se acerca y hace paralaje. */}
      <div class="overflow-hidden rounded-3xl">
      <Image
        data-hero-portrait
        src={portrait}
        alt={lang === 'es' ? 'Retrato de Javier Montaño sonriendo' : 'Portrait of Javier Montaño smiling'}
        widths={[480, 800, 1000]}
        sizes="(min-width: 1024px) 400px, calc(100vw - 32px)"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full object-cover object-[50%_22%]"
      />
      </div>

      <div
        class="relative mx-4 -mt-24 rounded-2xl border border-line bg-surface/95 p-5 shadow-[0_12px_40px_-12px_rgb(0_0_0/0.35)] backdrop-blur-md sm:mx-6 lg:absolute lg:-bottom-8 lg:-left-8 lg:mx-0 lg:mt-0 lg:w-[320px]"
      >
        <dl class="flex flex-col divide-y divide-line">
          {
            Object.values(heroCard).map((item) => (
              <div class="flex gap-3.5 py-3.5 first:pt-0 last:pb-0">
                <svg class="mt-0.5 shrink-0 text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={item.icon} />
                </svg>
                <div>
                  <dt class="text-[15px] font-semibold leading-snug">{t(item.title, lang)}</dt>
                  <dd class="mt-0.5 text-[13px] leading-snug text-muted">{t(item.detail, lang)}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </div>
</header>
