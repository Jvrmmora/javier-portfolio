---
import Section from './Section.astro';
import { services } from '../data/services';
import { langFromUrl, t, ui } from '../i18n/config';

const lang = langFromUrl(Astro.url);
---

<Section
  id="servicios"
  title={t(ui.sections.servicesTitle, lang)}
  eyebrow={`${services.length} ${t(ui.sections.servicesEyebrow, lang)}`}
  lead={t(ui.sections.servicesLead, lang)}
>
  <div class="grid gap-4 md:grid-cols-2" data-reveal-group>
    {
      services.map((s) => (
        <article
          class="group flex flex-col rounded-2xl border border-line bg-surface/60 p-6 transition duration-300 hover:-translate-y-0.5 hover:border-accent-text/40 hover:bg-surface hover:shadow-[0_16px_40px_-20px_rgb(0_0_0/0.35)] md:p-8"
          data-reveal
        >
          {/* Ámbar suave como sello de cada servicio: es un tinte al 12%, no el ámbar
              pleno de los botones, así no se confunde con algo que se pueda pulsar. */}
          <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/12 text-accent-text">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={s.icon} />
            </svg>
          </span>

          <h3 class="mt-6 font-display text-xl leading-snug font-semibold tracking-[-0.02em] md:text-2xl">
            {t(s.title, lang)}
          </h3>

          <p class="mt-3 text-[15px] leading-relaxed text-muted">{t(s.body, lang)}</p>

          <ul class="mt-6 flex flex-wrap gap-2">
            {s.includes.map((item) => (
              <li class="rounded-full border border-line bg-bg/60 px-3 py-1 text-xs text-text/85">{t(item, lang)}</li>
            ))}
          </ul>

          {/* Verde = dato verificado: la prueba real detrás de cada servicio. */}
          <div class="mt-auto pt-7">
            <div class="flex gap-3 rounded-xl bg-ok/10 px-4 py-3.5">
              <svg class="mt-0.5 shrink-0 text-ok" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" />
              </svg>
              <p class="text-[13px] leading-snug">
                <span class="block font-semibold text-ok">{t(ui.sections.servicesProof, lang)}</span>
                <span class="mt-0.5 block text-text">{t(s.proof, lang)}</span>
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Section>
