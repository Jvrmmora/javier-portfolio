---
import Section from './Section.astro';
import { services } from '../data/services';
import { langFromUrl, t, ui } from '../i18n/config';

const lang = langFromUrl(Astro.url);
---

<Section
  id="servicios"
  title={t(ui.sections.servicesTitle, lang)}
  eyebrow={`${services.length} ${t(ui.sections.servicesEyebrow, lang)}`}
  lead={t(ui.sections.servicesLead, lang)}
>
  <!-- Índice editorial: un servicio por fila, a todo el ancho, como el índice de una
       consultora. Rompe la serie de rejillas de tarjetas de la página (métricas, stack,
       contacto) y deja que cada servicio se lea de corrido: qué es, qué incluye y qué
       lo respalda. -->
  <ol class="border-t border-line" data-reveal-group>
    {
      services.map((s, i) => (
        <li class="group relative isolate border-b border-line" data-reveal>
          {/* Fondo que aparece al pasar el ratón. Sobresale de la fila por los lados
              para que el contenido no se mueva ni toque el borde del resaltado. */}
          <span
            class="absolute inset-y-2 -inset-x-3 -z-10 rounded-2xl bg-surface/0 transition-colors duration-300 group-hover:bg-surface/70 md:-inset-x-5"
            aria-hidden="true"
          />

          <article class="grid gap-x-10 gap-y-6 py-8 md:py-10 lg:grid-cols-12">
            {/* El número es el ancla visual de la fila: grande y apagado, y se enciende
                en ámbar al pasar el ratón. */}
            <span
              class="font-display tabular text-3xl leading-none font-semibold tracking-[-0.04em] text-muted/50 transition-colors duration-300 group-hover:text-accent-text md:text-5xl lg:col-span-2"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="lg:col-span-6">
              <div class="flex items-center gap-3.5">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-line bg-bg text-text transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={s.icon} />
                  </svg>
                </span>
                <h3 class="font-display text-2xl leading-tight font-semibold tracking-[-0.025em] md:text-[1.75rem]">
                  {t(s.title, lang)}
                </h3>
              </div>

              <p class="mt-4 max-w-[58ch] leading-relaxed text-muted">{t(s.body, lang)}</p>

              {/* La prueba como una línea firmada, no como una caja de aviso: rótulo
                  pequeño y el dato en el color del texto, con enlace a donde se ve. */}
              <a
                href={s.proofHref}
                class="group/proof mt-6 inline-flex max-w-full items-start gap-3 rounded-lg text-sm"
              >
                <span class="mt-[0.35em] h-2 w-2 shrink-0 rotate-45 rounded-[2px] bg-accent" aria-hidden="true" />
                <span class="min-w-0">
                  <span class="meta mr-2 tracking-[0.06em] uppercase">{t(ui.sections.servicesProof, lang)}</span>
                  <span class="font-medium text-text underline decoration-line underline-offset-4 transition-colors group-hover/proof:decoration-accent-text">
                    {t(s.proof, lang)}
                  </span>
                  <span
                    class="ml-1 inline-block text-muted transition-transform duration-300 group-hover:translate-x-1 group-hover/proof:text-accent-text"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </span>
              </a>
            </div>

            <div class="lg:col-span-4">
              <p class="meta mb-4">{t(ui.sections.includes, lang)}</p>
              <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2 lg:grid-cols-1">
                {s.includes.map((item) => (
                  <li class="flex items-start gap-2.5 text-[15px] leading-snug">
                    <svg class="mt-0.5 shrink-0 text-accent-text" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4 10-11" />
                    </svg>
                    {t(item, lang)}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</Section>
