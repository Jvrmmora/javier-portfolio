---
import RevealText from './RevealText.astro';

// Encabezado de sección en lenguaje llano: rótulo corto, título y una frase
// que dice para qué sirve la sección. Con `bare`, el contenido queda fuera del
// contenedor para poder ocupar todo el ancho de la página.
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  lead?: string;
  bare?: boolean;
  class?: string;
}
const { id, title, eyebrow, lead, bare = false, class: extra = '' } = Astro.props;
---

<!-- Solo relleno superior: con arriba y abajo, cada unión entre secciones sumaba los dos. -->
<section id={id} class={`pt-16 md:pt-24 ${extra}`}>
  <div class="container-site">
    <header class="mb-8 grid gap-4 md:mb-10 md:grid-cols-12 md:items-end md:gap-8" data-reveal>
      <div class="md:col-span-7">
        {eyebrow && <p class="meta mb-4">{eyebrow}</p>}
        <RevealText
          text={title}
          as="h2"
          class="font-display text-3xl leading-tight font-semibold tracking-[-0.03em] md:text-5xl"
        />
      </div>
      {lead && <p class="leading-relaxed text-muted md:col-span-5 md:max-w-[38ch] md:justify-self-end md:pb-1.5">{lead}</p>}
    </header>
    {!bare && <slot />}
  </div>
  {bare && <slot />}
</section>
