---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import Icon from './Icon.astro';
import TechChip from './TechChip.astro';
import { skillGroups, certifications, education } from '../data/skills';
import { langFromUrl, t, ui } from '../i18n/config';

const lang = langFromUrl(Astro.url);
---

<Section
  id="stack"
  title={t(ui.sections.stackTitle, lang)}
  eyebrow={t(ui.sections.stackEyebrow, lang)}
  lead={t(ui.sections.stackLead, lang)}
>
  <!-- Rejilla bento: una tarjeta por categoría, con el mismo lenguaje que las métricas
       (loseta arriba, hover con foco de luz). Backend, lo principal, ocupa dos columnas;
       "También" cierra como franja completa porque es lo de menos peso. -->
  <div class="grid gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-3" data-reveal-group>
    {
      skillGroups.map((g) => (
        <article
          class:list={[
            'group relative isolate flex flex-col overflow-hidden rounded-2xl border border-line bg-surface/50 p-6 transition-[translate,border-color,background-color,box-shadow] duration-300 hover:-translate-y-1 hover:border-accent-text/40 hover:bg-surface hover:shadow-[0_18px_40px_-20px_rgb(0_0_0/0.35)] md:p-7',
            g.span === 'wide' && 'md:col-span-2',
            g.span === 'full' && 'md:col-span-2 lg:col-span-3',
          ]}
          data-reveal
          data-spotlight
        >
          <header class="flex items-center gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-line bg-bg text-text transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={g.icon} />
              </svg>
            </span>
            <h3 class="font-display text-lg font-semibold tracking-[-0.02em]">{t(g.label, lang)}</h3>
            {/* Cuántas tecnologías hay en la categoría, en el estilo de un contador de terminal. */}
            <span class="ml-auto font-mono text-xs text-muted tabular">{String(g.items.length).padStart(2, '0')}</span>
          </header>

          <ul class="mt-6 flex flex-wrap gap-2">
            {g.items.map((i) => (
              <TechChip name={i.name} detail={i.detail} size="md" />
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <!-- Formación: sección propia con encabezado, no una nota al pie del stack. -->
  <div class="mt-14 md:mt-16">
    <h3 class="font-display text-2xl font-semibold tracking-[-0.03em] md:text-3xl" data-reveal>
      {t(ui.sections.education, lang)}
    </h3>

    <article
      class="mt-6 flex flex-col gap-6 rounded-2xl border border-line bg-surface p-6 sm:flex-row sm:items-center md:p-8"
      data-reveal
    >
      <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl border border-line bg-white p-2.5">
        <Image
          src={education.logo}
          alt={education.school}
          widths={[64, 128]}
          sizes="44px"
          class="h-full w-full object-contain"
        />
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-display text-xl font-semibold tracking-[-0.02em] md:text-2xl">{t(education.degree, lang)}</p>
        <p class="mt-1.5 text-[15px] text-muted">{education.school}</p>
      </div>
      <span class="font-display tabular text-2xl font-semibold tracking-[-0.03em] text-muted md:text-3xl">
        {education.year}
      </span>
    </article>

    <h3 class="mt-12 font-display text-2xl font-semibold tracking-[-0.03em] md:text-3xl" data-reveal>
      {t(ui.sections.certifications, lang)}
      <span class="ml-2 align-middle text-sm font-normal text-muted tabular">{certifications.length}</span>
    </h3>

    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((c) => (
          <li class="flex items-center gap-4 rounded-xl border border-line bg-surface/40 p-5" data-reveal>
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-line bg-bg">
              <Icon name={c.issuer} size={24} />
            </span>
            <div class="min-w-0">
              <p class="font-medium leading-snug">{t(c.name, lang)}</p>
              <p class="meta mt-1 tabular">
                {c.issuer}
                {c.year && ` · ${c.year}`}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<script>
  import '../scripts/spotlight';
</script>
