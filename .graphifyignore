# --- Noise / generated (always exclude) ---
node_modules/
dist/
.astro/
graphify-out/
reports/
*.tsbuildinfo
package-lock.json

# --- Binary assets (not useful for the code graph) ---
public/
src/assets/

# --- Secrets / local env ---
.env
.env.*
